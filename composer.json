{
    "name": "stillat/tesseract-agent",
    "description": "Tesseract agent for NativePHP Mobile applications.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Native\\Agent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Native\\Agent\\AgentServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "phrity/websocket": "^3.0",
        "fortephp/forte": "^0.1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27"
    }
}
